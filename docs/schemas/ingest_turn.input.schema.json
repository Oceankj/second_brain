{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:personal-agent-memory:schema:ingest_turn:input",
  "title": "ingest_turn input",
  "type": "object",
  "additionalProperties": false,
  "required": ["token", "user_input", "assistant_output", "metadata"],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "description": "API token used to authenticate the caller and resolve user identity."
    },
    "user_input": {
      "type": "string",
      "minLength": 1
    },
    "assistant_output": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "source", "ingest_reason"],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "資料來源，例如 codex、dify、claude-desktop。"
        },
        "app": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ingest_reason": {
          "$ref": "#/$defs/ingest_reason"
        }
      }
    }
  },
  "$defs": {
    "ingest_reason": {
      "type": "string",
      "description": "Explicit caller policy signal explaining why this interaction should become durable memory.",
      "enum": [
        "task_completed",
        "explicit_memory_request",
        "user_preference",
        "stable_fact",
        "personal_insight",
        "decision",
        "stable_artifact",
        "manual_import"
      ]
    }
  }
}
