# Local Docker Compose PostgreSQL.
POSTGRES_DB=personal_agent_memory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personal_agent_memory

MEMORY_EMBEDDING_DIMENSION=1536
MEMORY_MAX_CHUNK_CHARS=1800
MEMORY_CHUNK_OVERLAP_CHARS=200
