# Local Docker Compose PostgreSQL. Port 5433 avoids colliding with tools such
# as Dify that often use localhost:5432.
POSTGRES_DB=personal_agent_memory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/personal_agent_memory

MEMORY_EMBEDDING_DIMENSION=1536
MEMORY_MAX_CHUNK_CHARS=1800
MEMORY_CHUNK_OVERLAP_CHARS=200
